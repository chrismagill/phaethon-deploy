# ==============================================================
# Attestor — environment file
# Copy to `.env`, fill in every blank, then: docker compose up -d
# Do NOT commit or share this file once filled in.
# ==============================================================
# The one-liner in INSTALL-macOS.md generates all the secret values for you.
# Everything below is validated at startup — weak or missing values stop the
# container with a clear error (exit code 78).

# --- PostgreSQL ---------------------------------------------------
POSTGRES_USER=attestor
POSTGRES_DB=attestor

# Superuser password — used only for database init/migrations.
# 16+ chars, mixed upper/lower/digit/symbol.
POSTGRES_PASSWORD=

# Application role password (the unprivileged role the API connects as).
# Keep it DIFFERENT from POSTGRES_PASSWORD. Same strength rules.
APP_DB_PASSWORD=

# --- Application secrets ------------------------------------------
JWT_SECRET=              # openssl rand -hex 64   (session signing)
ENCRYPTION_KEY=          # openssl rand -hex 32   (AES-256 data-at-rest)
EVIDENCE_SIGNING_KEY=    # openssl rand -hex 32   (signs evidence bundles)

# --- Your license -------------------------------------------------
# Paste the Attestor license key from your Phaethon Security email.
LICENSE_KEY=

# Days the app keeps running (with a renewal warning) after the license
# expires, before it refuses to start.
LICENSE_GRACE_PERIOD_DAYS=14
