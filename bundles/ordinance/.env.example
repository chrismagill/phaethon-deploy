# ==============================================================
# Ordinance — environment file (REQUIRED)
# Copy this file to `.env` and set ORDINANCE_ACCEPT_TERMS=1. Everything else
# below is optional and has a sensible default.
#
#     cp .env.example .env
#     # edit .env: set ORDINANCE_ACCEPT_TERMS=1
#     docker compose up
# ==============================================================

# ── Terms of Use — REQUIRED ───────────────────────────────────
# Ordinance fails closed at startup until you accept its Terms of Use. This is
# a deliberate acknowledgment by you as the operator — we do not pre-accept it
# on your behalf. The version you accept is recorded in the boot log.
#
# Read them first: legal/terms_of_use.md inside the image, or GET /terms once
# running. Then uncomment the line below.
#
# ORDINANCE_ACCEPT_TERMS=1

# ── Evaluation (default) ──────────────────────────────────────
# Keyless: Ordinance self-issues a short-lived license at startup. Leave as-is
# to evaluate with no key.
ORDINANCE_EVAL=1

# Sign-in key for the console (http://localhost:8088/) and the X-Api-Key header.
# Defaults to "ordinance-trial-key" if unset. Change it for anything beyond a
# local trial — generate a strong one with:  openssl rand -hex 32
ORDINANCE_API_KEY=ordinance-trial-key

# Host port to publish on (container always listens on 8080 internally).
# Default 8088 avoids clashing with Attestor's 8080/8443 on the same machine.
ORDINANCE_HOST_PORT=8088

# Decision returned when no policy rule matches an action at all.
# One of: allow | deny | escalate   (escalate is the safe default)
ORDINANCE_DEFAULT_DECISION=escalate

# ── Production ────────────────────────────────────────────────
# For a licensed deployment, comment out ORDINANCE_EVAL above and paste the
# license key from your Phaethon Security email here:
# LICENSE_KEY=PHLK1....
# ORDINANCE_LICENSE_GRACE_PERIOD_DAYS=14
