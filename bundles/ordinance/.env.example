# ==============================================================
# Ordinance — environment file (REQUIRED)
#
#     cp .env.example .env
#     # edit .env: set the two REQUIRED values below
#     docker compose up -d
#
# Keep .env private (chmod 600 .env) — it holds your API keys.
# ==============================================================

# ── 1. Terms of Use — REQUIRED ────────────────────────────────
# Ordinance fails closed at startup until you accept its Terms of Use. This is
# a deliberate acknowledgment by you as the operator — we do not pre-accept it
# on your behalf. The version you accept is recorded in the boot log.
#
# Read them first: legal/terms_of_use.md inside the image, or GET /terms once
# running. Then uncomment the line below.
#
# ORDINANCE_ACCEPT_TERMS=1

# ── 2. API key — REQUIRED ─────────────────────────────────────
# The secret your callers send as the X-Api-Key header. There is no default.
# Generate one and paste it after the = sign:
#     macOS / Linux:  openssl rand -hex 32
#     Windows:        -join ((1..32) | % { '{0:x2}' -f (Get-Random -Max 256) })
#
# This is NOT how you sign in to the console — the console uses the operator
# account you create on first run (password + authenticator app).
ORDINANCE_API_KEY=

# ── Named caller keys (recommended beyond a trial) ────────────
# One key per calling system or agent, so every decision records which
# integration asked. Format: name=key,name2=key2  (names: letters, digits . _ -)
# ORDINANCE_API_KEYS=ops-copilot=<key>,billing-agent=<key>
#
# Which of those names may approve or reject escalations through the API (for
# a ticketing or chat-ops integration). Leave unset and only signed-in console
# operators can approve. The baseline key above can never approve.
# ORDINANCE_APPROVER_KEYS=ticketing

# ── Network ───────────────────────────────────────────────────
# Host port (the container always listens on 8080 internally). 8088 avoids
# clashing with Attestor's 8080/8443 on the same machine.
ORDINANCE_HOST_PORT=8088
# Interface the port is published on. 127.0.0.1 = this machine only. Ordinance
# speaks plain HTTP: to serve other machines, put a TLS reverse proxy in front
# (see PRODUCTION.md) instead of changing this.
# ORDINANCE_BIND=127.0.0.1

# ── Decisions ─────────────────────────────────────────────────
# Decision when no policy rule matches an action and no bundle declares its own
# default. One of: allow | deny | escalate   (escalate is the safe default)
ORDINANCE_DEFAULT_DECISION=escalate
# How long an approved escalation stays usable by the caller (seconds).
# ORDINANCE_APPROVAL_TTL_SECONDS=86400

# ── Console first-run setup ───────────────────────────────────
# Creating the first operator needs a one-time setup code. Leave unset and
# Ordinance generates one and prints it in its log:  docker compose logs ordinance
# Or choose your own (12+ characters):
# ORDINANCE_SETUP_CODE=

# ── License ───────────────────────────────────────────────────
# Evaluation (default): Ordinance self-issues a short-lived local license.
ORDINANCE_EVAL=1
# Production: set ORDINANCE_EVAL= (empty) above and paste the license key from
# your Phaethon Security email here:
# LICENSE_KEY=PHLK1....
# ORDINANCE_LICENSE_GRACE_PERIOD_DAYS=14
